rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == "admin";
    }
    function isVerifiedApp() { return request.app != null; }

    // Listings: public read when published; admin can manage
    match /listings/{doc} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Blog posts: public read when published; admin can manage
    match /blog_posts/{doc} {
      allow read: if resource.data.status == "published" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Publication queue: admin-only
    match /publication_queue/{doc} {
      allow read, write: if isAdmin();
    }

    // Newsletter subscriptions: anyone can create (App Check required); admin can read/manage
    match /newsletterSubscriptions/{doc} {
      allow create: if isVerifiedApp() && request.resource.data.email is string && request.resource.data.consent == true;
      allow read, update, delete: if isAdmin();
    }

    // Leads: public create with minimal validation (App Check required); admin can manage
    match /leads/{doc} {
      allow create: if (
        isVerifiedApp() &&
        request.resource.data.message is string &&
        (
          (request.resource.data.contact.email is string && request.resource.data.contact.email.size() > 0) ||
          (request.resource.data.contact.phone is string && request.resource.data.contact.phone.size() > 0)
        ) &&
        request.resource.data.consents.termsAccepted == true
      );
      allow read, update, delete: if isAdmin();
    }

    // Inquiries: admin-only until frontend inquiry flow is implemented
    match /inquiries/{doc} {
      allow read, write: if isAdmin();
    }

    // Referral logs: admin-only until referral tracking frontend is implemented
    match /user_referrals/{doc} {
      allow read, write: if isAdmin();
    }

    // Users: allow each signed-in user to create/read/update their own document; admin can manage all
    match /users/{uid} {
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // Roles: admin managed
    match /roles/{uid} {
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.email.matches('^.+@kotikreikasta\\.com$')
        && request.resource.data.role == "admin"
        && !exists(/databases/$(database)/documents/roles/$(uid));
      allow read: if isAdmin() || (isSignedIn() && resource.data.role == "admin");
      allow update, delete: if isAdmin();
    }

    // Persons: admin-only (partners, customers, stakeholders)
    match /persons/{doc} {
      allow read, create, update, delete: if isAdmin();
    }

    // Organizations (partner companies) and their business locations: admin-only
    match /organizations/{orgId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /organizations/{orgId}/locations/{locId} {
      allow read, create, update, delete: if isAdmin();
    }

    // All other collections: deny by default.
    // New collections must be explicitly added above before they can be accessed.
  }
}
