{
  "hosting": [
    {
      "source": "hosting",
      "site": "kotikreikasta",
      "frameworksBackend": {
        "region": "europe-west1"
      },
      "rewrites": [
        {
          "source": "/api/maps/key",
          "run": {
            "serviceId": "maps-key",
            "region": "europe-west1"
          }
        }
      ],
      "headers": [
        {
          "source": "/assets/**",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        }
      ]
    }
  ]
  ,
  "firestore": {
    "rules": "firestore.rules"
  }
}
